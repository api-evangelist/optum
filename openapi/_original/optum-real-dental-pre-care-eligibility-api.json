          }
        }
      },
      "DelegatedInfo": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string"
          },
          "contact": {
            "type": "object",
            "properties": {
              "phone": {
                "type": "string"
              }
            }
          },
          "addresses": {
            "type": "array",
            "items": {
